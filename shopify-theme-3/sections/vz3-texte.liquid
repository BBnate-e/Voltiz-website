{%- comment -%} Page simple : titre, texte, et un bouton (par exemple l'e-mail de contact). {%- endcomment -%}
<div class="v3">
  <section class="page" aria-labelledby="page-titre-{{ section.id }}">
    <div class="wrap page__in" data-reveal>
      {%- if section.settings.kicker != blank -%}<p class="label">{{ section.settings.kicker }}</p>{%- endif -%}
      <h1 id="page-titre-{{ section.id }}" class="title title--xl">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}
        <div class="page__text">
          {%- assign paras = section.settings.text | newline_to_br | split: '<br />' -%}
          {%- for p in paras -%}{%- assign p = p | strip -%}{%- if p != blank -%}<p>{% render 'voltiz-t', t: p %}</p>{%- endif -%}{%- endfor -%}
        </div>
      {%- endif -%}
      {%- if section.settings.show_email and shop.email != blank -%}
        <a class="btn" href="mailto:{{ shop.email }}"><svg aria-hidden="true"><use href="#i-mail"/></svg>{{ shop.email }}</a>
      {%- endif -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Voltiz 3 : texte",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Petit texte au-dessus", "default": "Voltiz" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "À propos." },
    { "type": "textarea", "id": "text", "label": "Texte", "info": "Un paragraphe par ligne." },
    { "type": "checkbox", "id": "show_email", "label": "Afficher l’e-mail de la boutique", "default": false }
  ],
  "presets": [{ "name": "Voltiz 3 : texte" }]
}
{% endschema %}
