{%- comment -%}
  Tableau comparatif : Voltiz face à d'autres façons de prendre de la caféine.
  Chaque ligne est un bloc. Valeurs : « oui » (coche), « non » (croix), « ~ » (partiel) ou un texte libre.
{%- endcomment -%}
<div class="v3">
  <section class="cmp" id="{{ section.settings.anchor }}" aria-labelledby="cmp-titre-{{ section.id }}">
    <div class="wrap">
      <header class="head" data-reveal>
        {%- if section.settings.kicker != blank -%}<p class="label">{{ section.settings.kicker }}</p>{%- endif -%}
        <h2 id="cmp-titre-{{ section.id }}" class="title">{{ section.settings.heading }}</h2>
      </header>
      <div class="cmp__scroll" data-reveal>
        <table class="cmp__table">
          <caption class="sr-only">{{ section.settings.heading }}</caption>
          <thead>
            <tr>
              <td></td>
              <th scope="col" class="cmp__us"><span class="cmp__brand"><svg aria-hidden="true"><use href="#i-bolt"/></svg>{{ section.settings.col1 }}</span></th>
              <th scope="col">{{ section.settings.col2 }}</th>
              <th scope="col">{{ section.settings.col3 }}</th>
            </tr>
          </thead>
          <tbody>
            {%- for block in section.blocks -%}
              <tr {{ block.shopify_attributes }}>
                <th scope="row">{{ block.settings.label }}</th>
                {%- assign vals = block.settings.v1 | append: '§' | append: block.settings.v2 | append: '§' | append: block.settings.v3 | split: '§' -%}
                {%- for v in vals -%}
                  {%- assign k = v | strip | downcase -%}
                  <td{% if forloop.first %} class="cmp__us"{% endif %}>
                    {%- if k == 'oui' or k == 'yes' -%}
                      <span class="cmp__mark cmp__mark--yes"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg><span class="sr-only">{% render 'vz-tr', k: 'cmp_yes' %}</span></span>
                    {%- elsif k == 'non' or k == 'no' -%}
                      <span class="cmp__mark cmp__mark--no"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7l10 10M17 7L7 17"/></svg><span class="sr-only">{% render 'vz-tr', k: 'cmp_no' %}</span></span>
                    {%- elsif k == '~' -%}
                      <span class="cmp__mark cmp__mark--mid"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 12h10"/></svg><span class="sr-only">{% render 'vz-tr', k: 'cmp_mid' %}</span></span>
                    {%- else -%}
                      <span class="cmp__txt">{{ v | strip }}</span>
                    {%- endif -%}
                  </td>
                {%- endfor -%}
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
      {%- if section.settings.note != blank -%}<p class="cmp__note" data-reveal>{{ section.settings.note }}</p>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <p class="cmp__cta" data-reveal><a class="btn" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}<svg aria-hidden="true"><use href="#i-arrow"/></svg></a></p>
      {%- endif -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Voltiz 8 : comparatif",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Ancre", "default": "comparatif" },
    { "type": "text", "id": "kicker", "label": "Petit texte au-dessus", "default": "Comparatif" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Voltiz, le café et la canette." },
    { "type": "text", "id": "col1", "label": "Colonne 1 (Voltiz)", "default": "Voltiz" },
    { "type": "text", "id": "col2", "label": "Colonne 2", "default": "Café" },
    { "type": "text", "id": "col3", "label": "Colonne 3", "default": "Boisson énergisante" },
    { "type": "textarea", "id": "note", "label": "Note sous le tableau" },
    { "type": "text", "id": "button_label", "label": "Texte du bouton" },
    { "type": "text", "id": "button_link", "label": "Lien du bouton", "default": "/products/voltiz-energy-gum" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Ligne",
      "settings": [
        { "type": "text", "id": "label", "label": "Critère", "default": "Sans sucre" },
        { "type": "text", "id": "v1", "label": "Voltiz (oui, non, ~ ou texte)", "default": "oui" },
        { "type": "text", "id": "v2", "label": "Colonne 2", "default": "oui" },
        { "type": "text", "id": "v3", "label": "Colonne 3", "default": "~" }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [{ "name": "Voltiz 8 : comparatif" }]
}
{% endschema %}
