{%- comment -%}
  1. Accueil : photos plein écran qui défilent (une par moment), slogan, une phrase, le bouton Commander,
  et la photo du produit (sachet) à droite si elle est choisie.
  Chaque photo est un bloc (photo, heure, moment). Un bouton met le défilement en pause.
{%- endcomment -%}
<div class="vz">
  <section class="hero" id="{{ section.settings.anchor }}" aria-labelledby="hero-titre-{{ section.id }}" data-vz-slides data-interval="{{ section.settings.interval }}">
    <div class="hero__slides" aria-hidden="true">
      {%- for block in section.blocks -%}
        <figure class="hero__slide{% if forloop.first %} is-on{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {%- if forloop.first -%}
              {{ block.settings.image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 1920, 2400', sizes: '100vw', class: 'hero__img', alt: '', fetchpriority: 'high' }}
            {%- else -%}
              {{ block.settings.image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 1920, 2400', sizes: '100vw', class: 'hero__img', alt: '', loading: 'lazy' }}
            {%- endif -%}
          {%- endif -%}
        </figure>
      {%- endfor -%}
    </div>

    <div class="wrap hero__in">
      <div class="hero__text">
        {%- if section.settings.eyebrow != blank -%}<p class="kicker" data-reveal>{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h1 id="hero-titre-{{ section.id }}" class="hero__title" data-reveal>
          <span>{{ section.settings.title_1 }}</span>
          <span class="hero__title-2">{{ section.settings.title_2 }}</span>
        </h1>
        {%- if section.settings.lead != blank -%}<p class="hero__lead" data-reveal>{% render 'voltiz-t', t: section.settings.lead %}</p>{%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <p class="hero__cta" data-reveal>
            <a class="btn" href="{{ section.settings.button_link | default: '/pages/boutique' }}">{{ section.settings.button_label }}<svg aria-hidden="true"><use href="#i-arrow"/></svg></a>
          </p>
        {%- endif -%}
      </div>

      {%- if section.settings.pack_image != blank -%}
        <a class="hero__pack" href="{{ section.settings.button_link | default: '/pages/boutique' }}" data-reveal>
          {{ section.settings.pack_image | image_url: width: 1000 | image_tag: widths: '320, 480, 720, 1000', sizes: '(min-width: 990px) 34vw, 60vw', class: 'hero__pack-img', alt: section.settings.pack_alt, fetchpriority: 'high' }}
        </a>
      {%- elsif request.design_mode -%}
        <p class="hero__pack hero__pack--empty">Ajoute ici la photo du sachet<br><small>Réglages de la section, « Photo du produit »</small></p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="hero__now">
          <p class="hero__caption" aria-live="off">
            {%- for block in section.blocks -%}
              <span class="hero__cap{% if forloop.first %} is-on{% endif %}"><span><svg aria-hidden="true"><use href="#u-{{ block.settings.icon }}"/></svg>{{ block.settings.text }}</span></span>
            {%- endfor -%}
          </p>
          <div class="hero__bars" aria-hidden="true">
            {%- for block in section.blocks -%}<span class="hero__bar{% if forloop.first %} is-on{% endif %}"><i></i></span>{%- endfor -%}
          </div>
          {%- if section.blocks.size > 1 -%}
            <button type="button" class="hero__pause" data-vz-pause aria-pressed="false">
              <span class="sr-only" data-label-pause="Mettre les photos en pause" data-label-play="Relancer les photos">Mettre les photos en pause</span>
              <svg class="hero__i-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h3v14H7zM14 5h3v14h-3z"/></svg>
              <svg class="hero__i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
            </button>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Voltiz : accueil",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Ancre", "default": "accueil" },
    { "type": "text", "id": "eyebrow", "label": "Petit texte au-dessus", "default": "Voltiz · Energy candy" },
    { "type": "text", "id": "title_1", "label": "Titre, ligne 1", "default": "Ton énergie." },
    { "type": "text", "id": "title_2", "label": "Titre, ligne 2", "default": "Partout, à tout moment." },
    { "type": "text", "id": "lead", "label": "Phrase d’accroche", "default": "Le bonbon énergisant au maté. 50 mg de caféine par pièce, absorbé en 5 minutes." },
    { "type": "text", "id": "button_label", "label": "Texte du bouton", "default": "Commander" },
    { "type": "text", "id": "button_link", "label": "Lien du bouton", "default": "/pages/boutique" },
    { "type": "image_picker", "id": "pack_image", "label": "Photo du produit", "info": "Le sachet, idéalement détouré (PNG sans fond). Elle s’affiche à droite du texte, par-dessus les photos." },
    { "type": "text", "id": "pack_alt", "label": "Description de la photo du produit", "default": "Sachet Voltiz Energy Candy" },
    { "type": "range", "id": "interval", "label": "Durée par photo", "min": 3, "max": 10, "step": 1, "unit": "s", "default": 5 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        {
          "type": "select", "id": "icon", "label": "Icône", "default": "energie",
          "options": [
            { "value": "energie", "label": "Éclair" },
            { "value": "sport", "label": "Course" },
            { "value": "etudes", "label": "Livre" },
            { "value": "conduite", "label": "Voiture" },
            { "value": "travail", "label": "Mallette" },
            { "value": "aventure", "label": "Montagnes" }
          ]
        },
        { "type": "text", "id": "text", "label": "Moment", "default": "Énergie" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Voltiz : accueil" }]
}
{% endschema %}
