{%- comment -%} 1. Hero : slogan, texte d'accroche, bouton et photo du sachet. {%- endcomment -%}
<div class="vz">
  <section class="hero" aria-labelledby="titre-{{ section.id }}">
    <svg class="hero__eclair" aria-hidden="true"><use href="#eclair"/></svg>
    <div class="hero__in wrap">
      <div class="hero__text">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow load d1"><svg class="ch" aria-hidden="true"><use href="#ch"/></svg><span lang="en">{{ section.settings.eyebrow }}</span></p>
        {%- endif -%}
        <h1 id="titre-{{ section.id }}" class="display hero__title load d2"><span>{{ section.settings.title_1 }}</span> <span>{{ section.settings.title_2 }}</span></h1>
        <p class="hero__lead load d3">{% render 'voltiz-t', t: section.settings.lead %}</p>
        <div class="hero__cta load d4">
          {%- if section.settings.button_label != blank -%}
            <a class="btn" href="{{ section.settings.button_target }}">{{ section.settings.button_label }}<svg aria-hidden="true"><use href="#i-arrow"/></svg></a>
          {%- endif -%}
          {%- if section.settings.link_label != blank -%}
            <a class="link" href="{{ section.settings.link_target }}">{{ section.settings.link_label }}</a>
          {%- endif -%}
        </div>
      </div>
      <figure class="hero__pouch">
        <div class="hero__tilt load d2">
          {%- if section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 840 | image_tag: widths: '420, 480, 668, 840', sizes: '(min-width: 900px) 420px, min(62vw, 300px)', fetchpriority: 'high', loading: 'eager', alt: section.settings.image_alt }}
          {%- else -%}
            <img src="{{ 'voltiz-sachet.webp' | asset_url }}"
                 srcset="{{ 'voltiz-sachet-420.webp' | asset_url }} 420w, {{ 'voltiz-sachet-480.webp' | asset_url }} 480w, {{ 'voltiz-sachet.webp' | asset_url }} 668w"
                 sizes="(min-width: 900px) 420px, min(62vw, 300px)"
                 width="668" height="1176" fetchpriority="high" decoding="async"
                 alt="{{ section.settings.image_alt | escape }}">
          {%- endif -%}
        </div>
      </figure>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Voltiz : hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Petite ligne au-dessus du titre",
      "default": "Swiss made"
    },
    {
      "type": "text",
      "id": "title_1",
      "label": "Titre, ligne 1",
      "default": "Partout,"
    },
    {
      "type": "text",
      "id": "title_2",
      "label": "Titre, ligne 2",
      "default": "à tout moment."
    },
    {
      "type": "text",
      "id": "lead",
      "label": "Texte d’accroche",
      "default": "Le bonbon énergisant au maté, au guarana et à la L-théanine. 50 mg de caféine par gum, sans sucre."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texte du bouton",
      "default": "Commander"
    },
    {
      "type": "text",
      "id": "button_target",
      "label": "Lien du bouton",
      "default": "#commander"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Texte du lien secondaire",
      "default": "Voir la composition"
    },
    {
      "type": "text",
      "id": "link_target",
      "label": "Lien secondaire",
      "default": "#dedans"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo du sachet",
      "info": "Vide : la photo du prototype est utilisée."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Description de la photo (pour les lecteurs d’écran)",
      "default": "Le sachet Voltiz Energy Gum, face avant : logo Voltiz, badge Maté, 50 mg de caféine par gum, Swiss made."
    }
  ],
  "presets": [
    {
      "name": "Voltiz : hero"
    }
  ]
}
{% endschema %}
