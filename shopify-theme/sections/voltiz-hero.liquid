{%- comment -%} 1. Hero : marque, slogan, une phrase, un bouton. Visuel graphique jaune tant qu'aucune photo n'est choisie. {%- endcomment -%}
<div class="vz">
  <section class="hero" aria-labelledby="hero-titre-{{ section.id }}">
    <div class="wrap hero__in">
      <div class="hero__text">
        {%- if section.settings.eyebrow != blank -%}<p class="kicker" data-reveal>{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h1 id="hero-titre-{{ section.id }}" class="hero__title" data-reveal>
          <span>{{ section.settings.title_1 }}</span>
          <span>{{ section.settings.title_2 }}</span>
        </h1>
        {%- if section.settings.lead != blank -%}<p class="hero__lead" data-reveal>{% render 'voltiz-t', t: section.settings.lead %}</p>{%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <p class="hero__cta" data-reveal>
            <a class="btn" href="{{ section.settings.button_link | default: '#commander' }}">{{ section.settings.button_label }}<svg aria-hidden="true"><use href="#i-arrow"/></svg></a>
          </p>
        {%- endif -%}
      </div>

      <div class="hero__visual{% if section.settings.image != blank %} hero__visual--photo{% endif %}" data-reveal>
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1400 | image_tag: widths: '480, 720, 960, 1200, 1400', sizes: '(min-width: 990px) 50vw, 100vw', class: 'hero__img', alt: section.settings.image.alt, fetchpriority: 'high' }}
        {%- else -%}
          <div class="mark" aria-hidden="true">
            <span class="mark__ring"></span>
            <span class="mark__hatch"></span>
            <svg class="mark__bolt"><use href="#i-bolt"/></svg>
          </div>
        {%- endif -%}
      </div>
    </div>
    <span class="hero__slash" aria-hidden="true"></span>
  </section>
</div>

{% schema %}
{
  "name": "Voltiz : hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Petit texte au-dessus", "default": "Energy candy · Citron" },
    { "type": "text", "id": "title_1", "label": "Titre, ligne 1", "default": "Partout." },
    { "type": "text", "id": "title_2", "label": "Titre, ligne 2", "default": "À tout moment." },
    { "type": "text", "id": "lead", "label": "Phrase d’accroche", "default": "Un bonbon mou au citron, avec 50 mg de caféine naturelle. Sans sucre, fait en Suisse." },
    { "type": "text", "id": "button_label", "label": "Texte du bouton", "default": "Commander" },
    { "type": "text", "id": "button_link", "label": "Lien du bouton", "default": "#commander" },
    { "type": "image_picker", "id": "image", "label": "Photo (facultatif)", "info": "Sans photo, un visuel jaune à l’éclair s’affiche." }
  ],
  "presets": [{ "name": "Voltiz : hero" }]
}
{% endschema %}
