{%- comment -%} En-tête Voltiz : logo, panier, bouton Commander, puis les onglets, toujours visibles (2e ligne sur tablette, menu caché sur téléphone). {%- endcomment -%}
{%- liquid
  assign base = ''
  unless template.name == 'index'
    assign base = routes.root_url
  endunless
-%}
<div class="vz vz-header">
  {% render 'voltiz-sprite' %}
  <a class="skip" href="#MainContent">Aller au contenu</a>
  <header class="top" id="top">
    <div class="top__in wrap">
      <a class="top__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}, page d’accueil">
        <svg viewBox="0 0 1118 536" aria-hidden="true"><use href="#logo"/></svg>
        {%- if section.settings.tagline != blank -%}<span class="top__tag">{{ section.settings.tagline }}</span>{%- endif -%}
      </a>
      {%- capture vz_links -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign href = block.settings.target
            if href contains '#'
              assign first = href | slice: 0
              if first == '#'
                assign href = base | append: href
              endif
            endif
          -%}
          {%- liquid
            assign current = false
            if href == request.path
              assign current = true
            elsif template.name == 'index' and href == routes.root_url
              assign current = true
            endif
          -%}
          <a href="{{ href }}"{% if current %} aria-current="page"{% endif %} {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
        {%- endfor -%}
      {%- endcapture -%}
      <a class="top__cart" href="{{ routes.cart_url }}" aria-label="Panier, {{ cart.item_count }} article{% if cart.item_count > 1 %}s{% endif %}">
        <svg aria-hidden="true"><use href="#i-bag"/></svg>
        {%- if cart.item_count > 0 -%}<span class="top__count" aria-hidden="true">{{ cart.item_count }}</span>{%- endif -%}
      </a>
      {%- if section.settings.cta_label != blank -%}
        {%- liquid
          assign cta = section.settings.cta_target
          assign first = cta | slice: 0
          if first == '#'
            assign cta = base | append: cta
          endif
        -%}
        <a class="btn btn--sm top__cta" href="{{ cta }}">{{ section.settings.cta_label }}</a>
      {%- endif -%}
      <nav class="top__nav" aria-label="Navigation principale">{{ vz_links }}</nav>
      <details class="menu">
        <summary aria-label="Menu"><span></span><span></span><span></span></summary>
        <nav class="menu__panel" aria-label="Menu">{{ vz_links }}</nav>
      </details>
    </div>
  </header>
</div>

{% schema %}
{
  "name": "Voltiz : en-tête",
  "class": "vz-header-section",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Texte sous le logo",
      "default": "Energy candy"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Texte du bouton",
      "default": "Commander"
    },
    {
      "type": "text",
      "id": "cta_target",
      "label": "Lien du bouton",
      "info": "Une adresse du site, par exemple /pages/boutique.",
      "default": "/pages/boutique"
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Lien",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Texte",
          "default": "Le produit"
        },
        {
          "type": "text",
          "id": "target",
          "label": "Lien",
          "info": "Une ancre de l’accueil /pages/boutique, /, … ou une adresse.",
          "default": "#boutique"
        }
      ]
    }
  ],
  "max_blocks": 7
}
{% endschema %}
