{%- comment -%} Pourquoi ça marche : un texte court, trois avantages, un visuel. {%- endcomment -%}
<div class="vz">
  <section class="sec" id="{{ section.settings.anchor }}" aria-labelledby="pourquoi-titre-{{ section.id }}">
    <div class="wrap why">
      <div class="why__text">
        <div class="sec__head" data-reveal>
          {%- if section.settings.kicker != blank -%}<p class="kicker">{{ section.settings.kicker }}</p>{%- endif -%}
          <h2 id="pourquoi-titre-{{ section.id }}" class="sec__title">{{ section.settings.heading }}</h2>
          {%- if section.settings.sub != blank -%}<p class="why__sub">{{ section.settings.sub }}</p>{%- endif -%}
          {%- if section.settings.text != blank -%}<p class="sec__intro">{% render 'voltiz-t', t: section.settings.text %}</p>{%- endif -%}
        </div>
        <ul class="rows" role="list">
          {%- for block in section.blocks -%}
            <li class="row" data-reveal {{ block.shopify_attributes }}>
              <span class="tile" aria-hidden="true"><svg><use href="#i-{{ block.settings.icon }}"/></svg></span>
              <div><h3 class="row__title">{{ block.settings.title }}</h3><p class="row__text">{% render 'voltiz-t', t: block.settings.text %}</p></div>
            </li>
          {%- endfor -%}
        </ul>
      </div>
      <div class="why__visual" data-reveal>
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1100 | image_tag: widths: '480, 720, 1100', sizes: '(min-width: 990px) 45vw, 100vw', class: 'why__img', alt: '', loading: 'lazy' }}
        {%- else -%}
          <div class="mark mark--panel" aria-hidden="true"><span class="mark__hatch"></span><svg class="mark__bolt"><use href="#i-bolt"/></svg></div>
        {%- endif -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Voltiz : pourquoi",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Ancre", "default": "comment" },
    { "type": "text", "id": "kicker", "label": "Petit texte au-dessus", "default": "Comment ça marche" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Le boost qui tient dans ta poche." },
    { "type": "text", "id": "sub", "label": "Sous-titre en gras", "default": "Pas de tasse, pas de canette, pas d’eau." },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Un bonbon mou au maté, à mâcher et à avaler." },
    { "type": "image_picker", "id": "image", "label": "Photo (facultatif)" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Avantage",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icône", "default": "timer", "options": [
          { "value": "timer", "label": "Chrono" }, { "value": "backpack", "label": "Sac" }, { "value": "nosugar", "label": "Sans sucre" },
          { "value": "bolt", "label": "Éclair" }, { "value": "leaf", "label": "Feuille" }, { "value": "target", "label": "Cible" },
          { "value": "shield", "label": "Bouclier" }, { "value": "hourglass", "label": "Sablier" } ] },
        { "type": "text", "id": "title", "label": "Titre", "default": "Effet rapide" },
        { "type": "text", "id": "text", "label": "Texte", "default": "La caféine passe par la bouche." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Voltiz : pourquoi" }]
}
{% endschema %}
