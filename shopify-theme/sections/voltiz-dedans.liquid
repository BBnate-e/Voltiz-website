{%- comment -%} 3. Ce qu'il y a dedans : grille de cartes (maté, guarana, total, L-théanine, B12). {%- endcomment -%}
<div class="vz">
  <section class="dedans" id="{{ section.settings.anchor }}" aria-labelledby="dedans-titre-{{ section.id }}">
    <div class="wrap">
      <h2 id="dedans-titre-{{ section.id }}" class="display vz-h2" data-reveal>{{ section.settings.heading }}</h2>
      {%- if section.settings.sub != blank -%}<p class="vz-h2-sub" data-reveal>{% render 'voltiz-t', t: section.settings.sub %}</p>{%- endif -%}
      <div class="bento">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <article class="cell cell--{{ b.style }}" data-reveal {{ block.shopify_attributes }}>
            {%- case b.icon -%}
              {%- when 'leaf' -%}<svg class="cell__icon" aria-hidden="true"><use href="#i-leaf"/></svg>
              {%- when 'bolt' -%}<svg class="cell__icon" aria-hidden="true"><use href="#i-bolt-line"/></svg>
              {%- when 'plant' -%}<svg class="cell__icon" aria-hidden="true"><use href="#i-plant"/></svg>
              {%- when 'b12' -%}<span class="cell__hex" aria-hidden="true"><svg><use href="#i-hexagon"/></svg><b>B12</b></span>
            {%- endcase -%}
            {%- if b.title != blank -%}<h3>{{ b.title }}</h3>{%- endif -%}
            {%- if b.text != blank -%}<p>{% render 'voltiz-t', t: b.text %}</p>{%- endif -%}
            {%- if b.big != blank -%}<p class="cell__big display">{{ b.big }}</p>{%- endif -%}
            {%- if b.unit != blank -%}<p class="cell__unit">{{ b.unit }}</p>{%- endif -%}
            {%- if b.note != blank -%}<p class="cell__note">{% render 'voltiz-t', t: b.note %}</p>{%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Voltiz : composition",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Ancre",
      "default": "dedans"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Ce qu’il y a dedans."
    },
    {
      "type": "text",
      "id": "sub",
      "label": "Sous-titre",
      "default": "Maté, guarana, L-théanine. Et de la vitamine B12."
    }
  ],
  "blocks": [
    {
      "type": "cell",
      "name": "Carte",
      "settings": [
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "default": "thea",
          "options": [
            {
              "value": "mate",
              "label": "Bleu (petite)"
            },
            {
              "value": "guarana",
              "label": "Kraft (petite)"
            },
            {
              "value": "total",
              "label": "Jaune (petite)"
            },
            {
              "value": "thea",
              "label": "Kraft (large)"
            },
            {
              "value": "b12",
              "label": "Kraft (large, B12)"
            }
          ]
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icône",
          "default": "none",
          "options": [
            {
              "value": "none",
              "label": "Aucune"
            },
            {
              "value": "leaf",
              "label": "Feuille"
            },
            {
              "value": "bolt",
              "label": "Éclair"
            },
            {
              "value": "plant",
              "label": "Plante"
            },
            {
              "value": "b12",
              "label": "Hexagone B12"
            }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texte"
        },
        {
          "type": "text",
          "id": "big",
          "label": "Grand chiffre"
        },
        {
          "type": "text",
          "id": "unit",
          "label": "Sous le chiffre"
        },
        {
          "type": "text",
          "id": "note",
          "label": "Note"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Voltiz : composition"
    }
  ]
}
{% endschema %}
