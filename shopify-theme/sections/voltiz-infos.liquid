{%- comment -%} 6. Infos sur les ingrédients : un volet repliable par ingrédient. {%- endcomment -%}
<div class="vz">
  <section class="sec" id="{{ section.settings.anchor }}" aria-labelledby="infos-titre-{{ section.id }}">
    <div class="wrap split">
      <div class="sec__head" data-reveal>
        {%- if section.settings.kicker != blank -%}<p class="kicker">{{ section.settings.kicker }}</p>{%- endif -%}
        <h2 id="infos-titre-{{ section.id }}" class="sec__title">{{ section.settings.heading }}</h2>
        {%- if section.settings.intro != blank -%}<p class="sec__intro">{% render 'voltiz-t', t: section.settings.intro %}</p>{%- endif -%}
      </div>
      <div class="acc" data-reveal>
        {%- for block in section.blocks -%}
          <details {{ block.shopify_attributes }}>
            <summary>{{ block.settings.title }}<svg aria-hidden="true"><use href="#i-plus"/></svg></summary>
            {%- assign paras = block.settings.text | newline_to_br | split: '<br />' -%}
            <div class="acc__body">
              {%- for p in paras -%}{%- assign p = p | strip -%}{%- if p != blank -%}<p>{% render 'voltiz-t', t: p %}</p>{%- endif -%}{%- endfor -%}
            </div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Voltiz : infos ingrédients",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Ancre", "default": "infos" },
    { "type": "text", "id": "kicker", "label": "Petit texte au-dessus", "default": "Infos sur les ingrédients" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Pour les curieux." },
    { "type": "textarea", "id": "intro", "label": "Introduction" }
  ],
  "blocks": [
    {
      "type": "info",
      "name": "Ingrédient",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre", "default": "La caféine" },
        { "type": "textarea", "id": "text", "label": "Texte", "info": "Un paragraphe par ligne." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Voltiz : infos ingrédients" }]
}
{% endschema %}
