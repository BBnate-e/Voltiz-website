{%- comment -%} 5. Les saveurs. {%- endcomment -%}
<div class="vz">
  <section class="saveurs" id="{{ section.settings.anchor }}" aria-labelledby="saveurs-titre-{{ section.id }}">
    <div class="wrap">
      <h2 id="saveurs-titre-{{ section.id }}" class="display vz-h2" data-reveal>{{ section.settings.heading }}</h2>
      <div class="flavors">
        {%- for block in section.blocks -%}
          <article class="flavor flavor--{{ block.settings.style }}" data-reveal {{ block.shopify_attributes }}>
            {%- if block.settings.tag != blank -%}<p class="tag">{{ block.settings.tag }}</p>{%- endif -%}
            <div class="candy candy--{{ block.settings.style }}" aria-hidden="true"><svg><use href="#{% if block.settings.style == 'bois' %}i-bolt-line{% else %}i-bolt{% endif %}"/></svg></div>
            <h3 class="display">{{ block.settings.name }}</h3>
            <p>{% render 'voltiz-t', t: block.settings.text %}</p>
          </article>
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Voltiz : saveurs",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Ancre",
      "default": "saveurs"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Deux saveurs."
    }
  ],
  "blocks": [
    {
      "type": "flavor",
      "name": "Saveur",
      "settings": [
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "default": "citron",
          "options": [
            {
              "value": "citron",
              "label": "Jaune (citron)"
            },
            {
              "value": "bois",
              "label": "Noir (fruits des bois)"
            }
          ]
        },
        {
          "type": "text",
          "id": "name",
          "label": "Nom",
          "default": "Citron"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texte",
          "default": "La saveur principale de Voltiz."
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Étiquette",
          "info": "Par exemple : Édition limitée"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Voltiz : saveurs"
    }
  ]
}
{% endschema %}
