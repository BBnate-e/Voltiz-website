{%- comment -%} Tes moments : des cartes photo, un titre et deux lignes. {%- endcomment -%}
<div class="vz">
  <section class="sec" id="{{ section.settings.anchor }}" aria-labelledby="moments-titre-{{ section.id }}">
    <div class="wrap">
      <div class="sec__head" data-reveal>
        {%- if section.settings.kicker != blank -%}<p class="kicker">{{ section.settings.kicker }}</p>{%- endif -%}
        <h2 id="moments-titre-{{ section.id }}" class="sec__title">{{ section.settings.heading }}</h2>
      </div>
    </div>
    <ul class="cards wrap" role="list">
      {%- for block in section.blocks -%}
        <li class="card" data-reveal {{ block.shopify_attributes }}>
          <div class="card__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 800 | image_tag: widths: '360, 540, 800', sizes: '(min-width: 990px) 25vw, 75vw', class: 'card__img', alt: '', loading: 'lazy' }}
            {%- endif -%}
            {%- if block.settings.time != blank -%}<span class="card__time">{{ block.settings.time }}</span>{%- endif -%}
          </div>
          <h3 class="card__title">{{ block.settings.title }}</h3>
          <p class="card__text">{% render 'voltiz-t', t: block.settings.text %}</p>
        </li>
      {%- endfor -%}
    </ul>
  </section>
</div>

{% schema %}
{
  "name": "Voltiz : moments",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Ancre", "default": "moments" },
    { "type": "text", "id": "kicker", "label": "Petit texte au-dessus", "default": "Tes moments" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Pour les moments qui comptent." }
  ],
  "blocks": [
    {
      "type": "moment",
      "name": "Moment",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "time", "label": "Heure", "default": "06:12" },
        { "type": "text", "id": "title", "label": "Titre", "default": "Entraînement" },
        { "type": "text", "id": "text", "label": "Texte", "default": "Un bonbon avant de partir." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Voltiz : moments" }]
}
{% endschema %}
