{%- comment -%} 2. Moments : une carte photo par situation (heure, icône, nom), légère animation. {%- endcomment -%}
<div class="vz">
  <section class="moments" id="{{ section.settings.anchor }}" aria-labelledby="moments-titre-{{ section.id }}">
    <div class="wrap">
      <div class="moments__head" data-reveal>
        {%- if section.settings.kicker != blank -%}<p class="kicker">{{ section.settings.kicker }}</p>{%- endif -%}
        <h2 id="moments-titre-{{ section.id }}" class="moments__title">{{ section.settings.heading }}</h2>
      </div>
    </div>
    <ul class="moments__list wrap" role="list">
      {%- for block in section.blocks -%}
        <li class="moment" data-reveal {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 900 | image_tag: widths: '360, 540, 720, 900', sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 75vw', class: 'moment__img', alt: '', loading: 'lazy' }}
          {%- else -%}
            <span class="moment__img moment__img--empty" aria-hidden="true"></span>
          {%- endif -%}
          <div class="moment__text">
            {%- if block.settings.time != blank -%}<span class="moment__time">{{ block.settings.time }}</span>{%- endif -%}
            <span class="moment__name"><svg aria-hidden="true"><use href="#u-{{ block.settings.icon }}"/></svg>{{ block.settings.text }}</span>
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </section>
</div>

{% schema %}
{
  "name": "Voltiz : moments",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Ancre", "default": "moments" },
    { "type": "text", "id": "kicker", "label": "Petit texte au-dessus", "default": "Six moments, un bonbon" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Ton moment." }
  ],
  "blocks": [
    {
      "type": "moment",
      "name": "Moment",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "time", "label": "Heure", "default": "06:12" },
        {
          "type": "select", "id": "icon", "label": "Icône", "default": "energie",
          "options": [
            { "value": "energie", "label": "Éclair" },
            { "value": "sport", "label": "Course" },
            { "value": "etudes", "label": "Livre" },
            { "value": "conduite", "label": "Voiture" },
            { "value": "travail", "label": "Mallette" },
            { "value": "aventure", "label": "Montagnes" }
          ]
        },
        { "type": "text", "id": "text", "label": "Texte", "default": "Énergie" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Voltiz : moments" }]
}
{% endschema %}
