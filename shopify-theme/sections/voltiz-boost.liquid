{%- comment -%} 2. Le boost : 1 gum = BOOST, 2 gums = BOOOOST. {%- endcomment -%}
<div class="vz">
  <section class="boost" id="{{ section.settings.anchor }}" aria-labelledby="boost-titre-{{ section.id }}">
    <h2 id="boost-titre-{{ section.id }}" class="sr-only">{{ section.settings.sr_title }}</h2>
    <div class="wrap">
      {%- for block in section.blocks -%}
        {%- assign w = block.settings.word -%}
        <div class="boost__row{% if w == 'BOOOOST' %} boost__row--2{% endif %}" data-reveal {{ block.shopify_attributes }}>
          <div class="boost__icons" aria-hidden="true">
            {%- for i in (1..block.settings.bolts) -%}<svg><use href="#i-bolt"/></svg>{%- endfor -%}
          </div>
          {%- if w == 'BOOOOST' -%}
            <p class="display boost__eq">
              <span class="sr-only">{{ block.settings.amount }} = {{ w }}</span>
              <span class="boost__n" aria-hidden="true">{{ block.settings.amount }}</span>
              <span class="boost__w" aria-hidden="true">= BO<span class="o">O</span><span class="o">O</span><span class="st">OST</span></span>
            </p>
          {%- else -%}
            <p class="display boost__eq"><span class="boost__n">{{ block.settings.amount }}</span> <span class="boost__w">= {{ w }}</span></p>
          {%- endif -%}
          <p class="boost__note">{% render 'voltiz-t', t: block.settings.note %}</p>
        </div>
      {%- endfor -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Voltiz : le boost",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Ancre",
      "default": "boost"
    },
    {
      "type": "text",
      "id": "sr_title",
      "label": "Titre caché (lecteurs d’écran)",
      "default": "Combien en prendre"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Ligne",
      "settings": [
        {
          "type": "text",
          "id": "amount",
          "label": "Quantité",
          "default": "1 gum"
        },
        {
          "type": "text",
          "id": "word",
          "label": "Mot",
          "info": "Écris BOOOOST pour l’animation des O.",
          "default": "BOOST"
        },
        {
          "type": "range",
          "id": "bolts",
          "label": "Nombre d’éclairs",
          "min": 1,
          "max": 3,
          "step": 1,
          "default": 1
        },
        {
          "type": "text",
          "id": "note",
          "label": "Texte",
          "default": "<strong>50 mg de caféine.</strong> Un gum, quand tu en as besoin."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Voltiz : le boost"
    }
  ]
}
{% endschema %}
