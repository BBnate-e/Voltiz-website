{%- comment -%}
  Comparatif : Voltiz face au café, aux boissons énergisantes et aux comprimés.
  Dans chaque case : « oui », « non », « ~ » (ça dépend) ou un court texte.
{%- endcomment -%}
<div class="vz">
  <section class="sec" id="{{ section.settings.anchor }}" aria-labelledby="comparatif-titre-{{ section.id }}">
    <div class="wrap">
      <div class="sec__head sec__head--center" data-reveal>
        {%- if section.settings.kicker != blank -%}<p class="kicker">{{ section.settings.kicker }}</p>{%- endif -%}
        <h2 id="comparatif-titre-{{ section.id }}" class="sec__title">{{ section.settings.heading }}</h2>
      </div>
      <div class="compare" data-reveal>
        <table>
          <thead>
            <tr>
              <td></td>
              <th scope="col" class="compare__us"><svg viewBox="0 0 1118 536" role="img" aria-label="Voltiz"><use href="#logo"/></svg></th>
              <th scope="col">{{ section.settings.col_2 }}</th>
              <th scope="col">{{ section.settings.col_3 }}</th>
              <th scope="col">{{ section.settings.col_4 }}</th>
            </tr>
          </thead>
          <tbody>
            {%- for block in section.blocks -%}
              <tr {{ block.shopify_attributes }}>
                <th scope="row">{{ block.settings.label }}</th>
                {%- assign cells = block.settings.v1 | append: '§' | append: block.settings.v2 | append: '§' | append: block.settings.v3 | append: '§' | append: block.settings.v4 | split: '§' -%}
                {%- for c in cells -%}
                  {%- assign v = c | strip | downcase -%}
                  <td{% if forloop.first %} class="compare__us"{% endif %}>
                    {%- if v == 'oui' -%}<svg class="yes" aria-hidden="true"><use href="#i-check"/></svg><span class="sr-only">Oui</span>
                    {%- elsif v == 'non' -%}<svg class="no" aria-hidden="true"><use href="#i-x"/></svg><span class="sr-only">Non</span>
                    {%- elsif v == '~' -%}<svg class="maybe" aria-hidden="true"><use href="#i-tilde"/></svg><span class="sr-only">Ça dépend</span>
                    {%- else -%}{{ c | strip }}{%- endif -%}
                  </td>
                {%- endfor -%}
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
      {%- if section.settings.note != blank -%}<p class="compare__note" data-reveal>{% render 'voltiz-t', t: section.settings.note %}</p>{%- endif -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Voltiz : comparatif",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Ancre", "default": "comparatif" },
    { "type": "text", "id": "kicker", "label": "Petit texte au-dessus", "default": "Comparatif" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Tout ce que tu as sur ton bureau, comparé." },
    { "type": "text", "id": "col_2", "label": "Colonne 2", "default": "Café" },
    { "type": "text", "id": "col_3", "label": "Colonne 3", "default": "Boisson énergisante" },
    { "type": "text", "id": "col_4", "label": "Colonne 4", "default": "Comprimés" },
    { "type": "textarea", "id": "note", "label": "Note sous le tableau", "default": "~ : ça dépend du produit ou de la préparation." }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Ligne",
      "settings": [
        { "type": "text", "id": "label", "label": "Critère", "default": "Sans sucre" },
        { "type": "text", "id": "v1", "label": "Voltiz", "info": "oui, non, ~ ou un court texte", "default": "oui" },
        { "type": "text", "id": "v2", "label": "Colonne 2", "default": "~" },
        { "type": "text", "id": "v3", "label": "Colonne 3", "default": "~" },
        { "type": "text", "id": "v4", "label": "Colonne 4", "default": "oui" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Voltiz : comparatif" }]
}
{% endschema %}
