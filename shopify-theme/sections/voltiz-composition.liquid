{%- comment -%} 3. Composition : les ingrédients clés, la mention sans sucre et l'avertissement caféine, bien visible. {%- endcomment -%}
<div class="vz">
  <section class="sec sec--soft" id="{{ section.settings.anchor }}" aria-labelledby="compo-titre-{{ section.id }}">
    <div class="wrap compo">
      <div class="compo__visual" data-reveal>
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1000 | image_tag: widths: '480, 720, 1000', sizes: '(min-width: 990px) 40vw, 100vw', class: 'compo__img', alt: section.settings.image.alt, loading: 'lazy' }}
        {%- else -%}
          <div class="mark mark--panel mark--dark" aria-hidden="true">
            <span class="mark__hatch"></span>
            <svg class="mark__bolt"><use href="#i-bolt"/></svg>
          </div>
        {%- endif -%}
      </div>
      <div class="compo__body">
        <div class="sec__head" data-reveal>
          {%- if section.settings.kicker != blank -%}<p class="kicker">{{ section.settings.kicker }}</p>{%- endif -%}
          <h2 id="compo-titre-{{ section.id }}" class="sec__title">{{ section.settings.heading }}</h2>
        </div>
        <ul class="ingr" role="list">
          {%- for block in section.blocks -%}
            <li class="ingr__item" data-reveal {{ block.shopify_attributes }}>
              <span class="ingr__icon" aria-hidden="true"><svg><use href="#i-{{ block.settings.icon }}"/></svg></span>
              <div>
                <h3 class="ingr__name">{{ block.settings.name }}</h3>
                <p class="ingr__text">{% render 'voltiz-t', t: block.settings.text %}</p>
              </div>
            </li>
          {%- endfor -%}
        </ul>
        {%- if section.settings.sugar_text != blank -%}
          <p class="nosugar" data-reveal><svg aria-hidden="true"><use href="#i-nosugar"/></svg><span>{% render 'voltiz-t', t: section.settings.sugar_text %}</span></p>
        {%- endif -%}
      </div>
    </div>
    {%- if section.settings.warning_text != blank -%}
      <div class="wrap">
        <aside class="warn" aria-labelledby="warn-titre-{{ section.id }}" data-reveal>
          <h3 id="warn-titre-{{ section.id }}"><svg aria-hidden="true"><use href="#i-warning"/></svg>{{ section.settings.warning_title }}</h3>
          {%- assign paras = section.settings.warning_text | newline_to_br | split: '<br />' -%}
          {%- for p in paras -%}{%- assign p = p | strip -%}{%- if p != blank -%}<p>{% render 'voltiz-t', t: p %}</p>{%- endif -%}{%- endfor -%}
        </aside>
      </div>
    {%- endif -%}
  </section>
</div>

{% schema %}
{
  "name": "Voltiz : composition",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Ancre", "default": "composition" },
    { "type": "image_picker", "id": "image", "label": "Photo de l’arrière du sachet (facultatif)", "info": "Sans photo, un visuel jaune à l’éclair s’affiche." },
    { "type": "text", "id": "kicker", "label": "Petit texte au-dessus", "default": "Composition" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Ce qu’il y a dedans." },
    { "type": "text", "id": "sugar_text", "label": "Mention sans sucre", "default": "Sans sucre. Nos bonbons sont sucrés avec des édulcorants." },
    { "type": "text", "id": "warning_title", "label": "Titre de l’avertissement", "default": "Contient de la caféine" },
    { "type": "textarea", "id": "warning_text", "label": "Avertissement", "info": "Un paragraphe par ligne.", "default": "Déconseillé aux enfants, aux femmes enceintes ou allaitantes et aux personnes sensibles à la caféine.\nNe pas dépasser [À COMPLÉTER : nombre de bonbons] par jour. Une consommation excessive peut avoir des effets laxatifs." }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingrédient",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icône", "default": "leaf",
          "options": [
            { "value": "leaf", "label": "Feuille" },
            { "value": "bolt", "label": "Éclair" },
            { "value": "flask", "label": "Flacon" },
            { "value": "sparkle", "label": "Étincelle" },
            { "value": "coffee", "label": "Tasse" }
          ]
        },
        { "type": "text", "id": "name", "label": "Nom", "default": "Extrait de yerba maté" },
        { "type": "textarea", "id": "text", "label": "Texte", "default": "Source naturelle de caféine." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Voltiz : composition" }]
}
{% endschema %}
