{%- comment -%}
  9. Commander : choix de la saveur et de la quantité, puis ajout au panier Shopify.
  Le paiement et l'adresse se font ensuite dans la caisse Shopify.
{%- endcomment -%}
{%- assign product = section.settings.product -%}
<div class="vz">
  {%- if section.settings.show_separator -%}
    <div class="sep wrap" aria-hidden="true">
      <svg class="sep__bolt" viewBox="20 10 340 635"><path pathLength="1" d="M355 15 108 372l107-36zM292 262l-70 40L25 640z"/></svg>
    </div>
  {%- endif -%}
  <section class="order" id="{{ section.settings.anchor }}" aria-labelledby="order-titre-{{ section.id }}">
    <div class="wrap">
      <h2 id="order-titre-{{ section.id }}" class="display vz-h2" data-reveal>{{ section.settings.heading }}</h2>
      {%- if section.settings.sub != blank -%}<p class="vz-h2-sub" data-reveal>{% render 'voltiz-t', t: section.settings.sub %}</p>{%- endif -%}

      {%- if product == blank or product.available == false -%}
        <p class="closed" data-reveal><svg aria-hidden="true"><use href="#i-warning"/></svg>{{ section.settings.closed_text }}</p>
      {%- else -%}
        {%- assign current = product.selected_or_first_available_variant -%}
        {%- form 'product', product, class: 'order__grid', id: 'vz-order', data-money-format: shop.money_format, data-max: section.settings.max_qty, novalidate: 'novalidate' -%}
          <div class="summary" data-reveal>
            <div class="summary__prod">
              {%- if product.featured_image -%}
                {{ product.featured_image | image_url: width: 160 | image_tag: class: 'summary__img', alt: '', loading: 'lazy' }}
              {%- else -%}
                <span class="candy candy--citron candy--sm" aria-hidden="true"><svg><use href="#i-bolt"/></svg></span>
              {%- endif -%}
              <div>
                <p class="summary__name">{{ product.title }}</p>
                <p class="summary__unit">{{ section.settings.unit_label }}, <span data-vz-unit>{{ current.price | money }}</span></p>
                {%- if section.settings.content_text != blank -%}<p class="summary__unit">{% render 'voltiz-t', t: section.settings.content_text %}</p>{%- endif -%}
              </div>
            </div>
            <p class="summary__total">Total <output data-vz-total aria-live="polite">{{ current.price | money }}</output></p>
            <ul class="summary__info">
              {%- if section.settings.info_payment != blank -%}<li><svg aria-hidden="true"><use href="#i-receipt"/></svg><span>{% render 'voltiz-t', t: section.settings.info_payment %}</span></li>{%- endif -%}
              {%- if section.settings.info_delivery != blank -%}<li><svg aria-hidden="true"><use href="#i-truck"/></svg><span>{% render 'voltiz-t', t: section.settings.info_delivery %}</span></li>{%- endif -%}
            </ul>
          </div>

          <div class="fields" data-reveal>
            {%- if product.has_only_default_variant -%}
              <input type="hidden" name="id" value="{{ current.id }}" data-price="{{ current.price }}">
            {%- else -%}
              <fieldset class="flavor-pick">
                <legend>{{ product.options.first }}</legend>
                {%- for v in product.variants -%}
                  {%- liquid
                    assign bois = false
                    assign t = v.title | downcase
                    if t contains 'bois'
                      assign bois = true
                    endif
                  -%}
                  <label class="pick">
                    <input type="radio" name="id" value="{{ v.id }}" data-price="{{ v.price }}" {% if v.id == current.id %}checked{% endif %} {% unless v.available %}disabled{% endunless %}>
                    <span class="pick__box"><span class="candy candy--{% if bois %}bois{% else %}citron{% endif %} candy--xs" aria-hidden="true"><svg><use href="#{% if bois %}i-bolt-line{% else %}i-bolt{% endif %}"/></svg></span><span><b>{{ v.title }}</b>{% if v.available %}{{ v.price | money }}{% else %}Épuisé{% endif %}</span></span>
                  </label>
                {%- endfor -%}
              </fieldset>
            {%- endif -%}

            <div class="qty">
              <label for="qty-{{ section.id }}">Quantité</label>
              <div class="qty__ctrl">
                <button type="button" class="qty__btn" data-step="-1" aria-label="Retirer un strip"><svg aria-hidden="true"><use href="#i-minus"/></svg></button>
                <input id="qty-{{ section.id }}" name="quantity" type="number" inputmode="numeric" min="1" max="{{ section.settings.max_qty }}" value="1" aria-describedby="qty-help-{{ section.id }}">
                <button type="button" class="qty__btn" data-step="1" aria-label="Ajouter un strip"><svg aria-hidden="true"><use href="#i-plus"/></svg></button>
              </div>
              <p class="help" id="qty-help-{{ section.id }}">De 1 à {{ section.settings.max_qty }} strips par commande.</p>
            </div>

            <div class="submit">
              <button class="btn btn--lg" type="submit">{{ section.settings.button_label }}<svg aria-hidden="true"><use href="#i-arrow"/></svg></button>
              <p class="submit__total">Total : <span data-vz-total>{{ current.price | money }}</span></p>
            </div>
            {%- if section.settings.legal_text != blank -%}<p class="help">{% render 'voltiz-t', t: section.settings.legal_text %}</p>{%- endif -%}
          </div>
        {%- endform -%}
      {%- endif -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Voltiz : commander",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Ancre",
      "default": "commander"
    },
    {
      "type": "checkbox",
      "id": "show_separator",
      "label": "Éclair qui se dessine au-dessus",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Commander."
    },
    {
      "type": "text",
      "id": "sub",
      "label": "Sous-titre",
      "default": "Choisis ta saveur et ta quantité. Tu paies en ligne à l’étape suivante."
    },
    {
      "type": "product",
      "id": "product",
      "label": "Produit"
    },
    {
      "type": "text",
      "id": "closed_text",
      "label": "Message si le produit n’est pas en vente",
      "default": "Les commandes ouvrent bientôt."
    },
    {
      "type": "text",
      "id": "unit_label",
      "label": "Unité",
      "default": "Le strip"
    },
    {
      "type": "text",
      "id": "content_text",
      "label": "Contenu",
      "default": "Contenu : [À COMPLÉTER]"
    },
    {
      "type": "text",
      "id": "info_payment",
      "label": "Ligne paiement",
      "default": "Paiement en ligne sécurisé à la caisse."
    },
    {
      "type": "text",
      "id": "info_delivery",
      "label": "Ligne livraison",
      "default": "Livraison en Suisse. Les frais s’affichent avant le paiement."
    },
    {
      "type": "range",
      "id": "max_qty",
      "label": "Quantité maximum",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 20
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texte du bouton",
      "default": "Ajouter au panier"
    },
    {
      "type": "text",
      "id": "legal_text",
      "label": "Petite ligne sous le bouton",
      "default": "Contient de la caféine. Déconseillé aux enfants, aux femmes enceintes ou allaitantes et aux personnes sensibles à la caféine."
    }
  ],
  "presets": [
    {
      "name": "Voltiz : commander"
    }
  ]
}
{% endschema %}
