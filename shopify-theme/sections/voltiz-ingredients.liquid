{%- comment -%} 6. Ingrédients et valeurs nutritionnelles (façon étiquette). Une ligne de note par ligne de texte. {%- endcomment -%}
<div class="vz">
  <section class="label-sec" id="{{ section.settings.anchor }}" aria-labelledby="ingredients-titre-{{ section.id }}">
    <div class="wrap">
      <div class="label" data-reveal>
        <div class="label__col">
          <h2 id="ingredients-titre-{{ section.id }}" class="label__h">{{ section.settings.ingr_heading }}</h2>
          {%- if section.settings.ingr_tag != blank -%}<p class="tag tag--line">{{ section.settings.ingr_tag }}</p>{%- endif -%}
          <p class="label__ingr">{% render 'voltiz-t', t: section.settings.ingr_text %}</p>
          {%- assign notes = section.settings.ingr_notes | newline_to_br | split: '<br />' -%}
          {%- for n in notes -%}{%- assign n = n | strip -%}{%- if n != blank -%}<p class="label__foot">{% render 'voltiz-t', t: n %}</p>{%- endif -%}{%- endfor -%}
        </div>
        <div class="label__col">
          <h3 class="label__h">{{ section.settings.nutri_heading }} <span>{{ section.settings.nutri_unit }}</span></h3>
          {%- if section.settings.nutri_tag != blank -%}<p class="tag tag--line">{{ section.settings.nutri_tag }}</p>{%- endif -%}
          <table class="nutri">
            <caption class="sr-only">{{ section.settings.nutri_heading }} {{ section.settings.nutri_unit }}</caption>
            <tbody>
              {%- for block in section.blocks -%}
                <tr{% if block.settings.sub %} class="sub"{% endif %} {{ block.shopify_attributes }}><th scope="row">{{ block.settings.label }}</th><td>{% render 'voltiz-t', t: block.settings.value %}</td></tr>
              {%- endfor -%}
            </tbody>
          </table>
          {%- assign notes = section.settings.nutri_notes | newline_to_br | split: '<br />' -%}
          {%- for n in notes -%}{%- assign n = n | strip -%}{%- if n != blank -%}<p class="label__foot">{% render 'voltiz-t', t: n %}</p>{%- endif -%}{%- endfor -%}
        </div>
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Voltiz : ingrédients",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Ancre",
      "default": "ingredients"
    },
    {
      "type": "text",
      "id": "ingr_heading",
      "label": "Titre des ingrédients",
      "default": "Ingrédients"
    },
    {
      "type": "text",
      "id": "ingr_tag",
      "label": "Étiquette",
      "default": "Liste provisoire, goût citron"
    },
    {
      "type": "textarea",
      "id": "ingr_text",
      "label": "Liste des ingrédients",
      "default": "Édulcorants (xylitol, sorbitol), arômes naturels (citron), caféine de guarana (30 mg par gum), extrait de yerba maté (100 mg par gum), L-théanine (100 mg par gum), vitamine B12 (cyanocobalamine), acidifiant (acide citrique), colorant naturel (curcumine)."
    },
    {
      "type": "textarea",
      "id": "ingr_notes",
      "label": "Notes sous les ingrédients",
      "info": "Une note par ligne.",
      "default": "[À CONFIRMER par le fabricant : liste et ordre définitifs]\n<b>Fruits des bois :</b> [À COMPLÉTER : liste des ingrédients]"
    },
    {
      "type": "text",
      "id": "nutri_heading",
      "label": "Titre du tableau",
      "default": "Valeurs nutritionnelles"
    },
    {
      "type": "text",
      "id": "nutri_unit",
      "label": "Unité du tableau",
      "default": "pour 100 g"
    },
    {
      "type": "text",
      "id": "nutri_tag",
      "label": "Étiquette du tableau",
      "default": "Valeurs indicatives, goût citron"
    },
    {
      "type": "textarea",
      "id": "nutri_notes",
      "label": "Notes sous le tableau",
      "info": "Une note par ligne.",
      "default": "VNR : valeur nutritionnelle de référence.\n<b>Fruits des bois :</b> [À COMPLÉTER : valeurs nutritionnelles]"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Ligne du tableau",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Nom",
          "default": "Énergie"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Valeur",
          "default": "698 kJ / 167 kcal"
        },
        {
          "type": "checkbox",
          "id": "sub",
          "label": "Sous-ligne (« dont … »)",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Voltiz : ingrédients"
    }
  ]
}
{% endschema %}
