{%- comment -%} 7. Swiss made. Un paragraphe par ligne de texte. {%- endcomment -%}
<div class="vz">
  <section class="swiss" id="{{ section.settings.anchor }}" aria-labelledby="swiss-titre-{{ section.id }}">
    <div class="wrap swiss__in">
      <svg class="swiss__cross" aria-hidden="true" data-reveal><use href="#ch"/></svg>
      <div class="swiss__text">
        <h2 id="swiss-titre-{{ section.id }}" class="display vz-h2" data-reveal><span lang="en">{{ section.settings.heading }}</span></h2>
        {%- assign paras = section.settings.text | newline_to_br | split: '<br />' -%}
        {%- for p in paras -%}{%- assign p = p | strip -%}{%- if p != blank -%}<p data-reveal>{% render 'voltiz-t', t: p %}</p>{%- endif -%}{%- endfor -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Voltiz : Swiss made",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Ancre",
      "default": "suisse"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Swiss made."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texte",
      "info": "Un paragraphe par ligne.",
      "default": "Voltiz est une jeune marque suisse. Nos bonbons sont fabriqués en Suisse.\n[À COMPLÉTER : l’histoire de Voltiz en deux phrases]"
    }
  ],
  "presets": [
    {
      "name": "Voltiz : Swiss made"
    }
  ]
}
{% endschema %}
