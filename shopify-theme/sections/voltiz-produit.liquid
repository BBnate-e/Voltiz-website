{%- comment -%}
  Boutique : visuel, points clés, choix du pack (1, 3 ou 5 strips), bouton qui reprend le choix,
  rassurance, volets d'infos, puis une barre d'achat qui reste en bas de l'écran.
  Le pack choisi fixe la quantité envoyée au panier Shopify. Le lien ?qty=3 présélectionne le pack.
  Le prix ne s'affiche que si la case est cochée (en attente des prix définitifs).
{%- endcomment -%}
{%- assign product = section.settings.product -%}
{%- assign packs = section.blocks | where: 'type', 'pack' -%}
{%- assign tabs = section.blocks | where: 'type', 'tab' -%}
{%- assign facts = section.blocks | where: 'type', 'fact' -%}
{%- assign best = 1 -%}
{%- assign best_label = '' -%}
{%- for b in packs -%}{%- if b.settings.highlight or forloop.first -%}{%- assign best = b.settings.qty -%}{%- assign best_label = b.settings.qty | append: ' ' | append: b.settings.unit -%}{%- endif -%}{%- endfor -%}
{%- if best_label == '' -%}{%- assign best_label = 'le strip' -%}{%- endif -%}
<div class="vz">
  <section class="prod" id="{{ section.settings.anchor }}" aria-labelledby="prod-titre-{{ section.id }}">
    <div class="wrap prod__in">
      <div class="prod__visual" data-reveal>
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1200 | image_tag: widths: '480, 720, 960, 1200', sizes: '(min-width: 990px) 45vw, 100vw', class: 'prod__img', alt: section.settings.image.alt, loading: 'eager' }}
        {%- elsif product.featured_image != blank -%}
          {{ product.featured_image | image_url: width: 1200 | image_tag: widths: '480, 720, 960, 1200', sizes: '(min-width: 990px) 45vw, 100vw', class: 'prod__img', loading: 'eager' }}
        {%- else -%}
          <div class="mark mark--panel" aria-hidden="true">
            <span class="mark__hatch"></span>
            <svg class="mark__bolt"><use href="#i-bolt"/></svg>
          </div>
        {%- endif -%}
      </div>

      <div class="prod__body" data-reveal>
        {%- if section.settings.eyebrow != blank -%}<p class="kicker">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 id="prod-titre-{{ section.id }}" class="prod__title">{{ section.settings.heading }}</h2>
        {%- if section.settings.sub != blank -%}<p class="prod__sub">{% render 'voltiz-t', t: section.settings.sub %}</p>{%- endif -%}

        {%- if facts.size > 0 -%}
          <ul class="chips" role="list">
            {%- for block in facts -%}
              <li {{ block.shopify_attributes }}><b>{{ block.settings.value }}</b><span>{% render 'voltiz-t', t: block.settings.text %}</span></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if product == blank or product.available == false -%}
          <p class="closed"><svg aria-hidden="true"><use href="#i-warning"/></svg>{{ section.settings.closed_text }}</p>
        {%- else -%}
          {%- assign current = product.selected_or_first_available_variant -%}
          {%- form 'product', product, class: 'buy', id: 'vz-order', data-money-format: shop.money_format, data-max: section.settings.max_qty, data-show-price: section.settings.show_price, novalidate: 'novalidate' -%}
            <input type="hidden" name="id" value="{{ current.id }}" data-price="{{ current.price }}">
            {%- unless product.has_only_default_variant -%}
              <p class="buy__flavor">{{ product.options.first }} : <b>{{ current.title }}</b></p>
            {%- endunless -%}

            {%- if packs.size > 0 -%}
              <input type="hidden" name="quantity" value="{{ best }}">
              <fieldset class="packs">
                <legend class="packs__legend">{{ section.settings.packs_heading }}</legend>
                {%- for block in packs -%}
                  <label class="pack{% if block.settings.highlight %} pack--best{% endif %}" {{ block.shopify_attributes }}>
                    <input type="radio" name="vz-pack-{{ section.id }}" value="{{ block.settings.qty }}" data-unit="{{ block.settings.unit | escape }}"{% if block.settings.qty == best %} checked{% endif %}>
                    <span class="pack__dot" aria-hidden="true"></span>
                    <span class="pack__main">
                      <span class="pack__name">{{ block.settings.qty }} {{ block.settings.unit }}{% if block.settings.tag != blank %} <em class="pack__tag">{{ block.settings.tag }}</em>{% endif %}</span>
                      <span class="pack__text">{% render 'voltiz-t', t: block.settings.text %}</span>
                    </span>
                    {%- if section.settings.show_price -%}<span class="pack__price">{{ current.price | times: block.settings.qty | money }}</span>{%- endif -%}
                  </label>
                {%- endfor -%}
              </fieldset>
            {%- else -%}
              <div class="qty">
                <label class="sr-only" for="qty-{{ section.id }}">Quantité</label>
                <button type="button" class="qty__btn" data-step="-1" aria-label="Un de moins"><svg aria-hidden="true"><use href="#i-minus"/></svg></button>
                <input id="qty-{{ section.id }}" name="quantity" type="number" inputmode="numeric" min="1" max="{{ section.settings.max_qty }}" value="1">
                <button type="button" class="qty__btn" data-step="1" aria-label="Un de plus"><svg aria-hidden="true"><use href="#i-plus"/></svg></button>
              </div>
            {%- endif -%}

            <button class="btn btn--wide btn--big" type="submit" data-vz-cta data-label="{{ section.settings.button_label | escape }}">
              <span data-vz-cta-text>{{ section.settings.button_label | replace: '[n]', best_label }}</span>
              {%- if section.settings.show_price -%}<span class="btn__sep" aria-hidden="true">·</span><span data-vz-total>{{ current.price | times: best | money }}</span>{%- endif -%}
              <svg aria-hidden="true"><use href="#i-arrow"/></svg>
            </button>

            {%- assign checks = section.settings.checks | split: '|' -%}
            {%- if section.settings.checks != blank -%}
              <ul class="checks" role="list">
                {%- for c in checks -%}<li><svg aria-hidden="true"><use href="#i-check"/></svg>{{ c | strip }}</li>{%- endfor -%}
              </ul>
            {%- endif -%}
          {%- endform -%}
        {%- endif -%}

        <div class="tabs">
          {%- for block in tabs -%}
            <details {{ block.shopify_attributes }}{% if forloop.first %} open{% endif %}>
              <summary>{{ block.settings.title }}<svg aria-hidden="true"><use href="#i-plus"/></svg></summary>
              <div class="tabs__body">
                {%- assign paras = block.settings.text | newline_to_br | split: '<br />' -%}
                {%- for p in paras -%}{%- assign p = p | strip -%}{%- if p != blank -%}<p>{% render 'voltiz-t', t: p %}</p>{%- endif -%}{%- endfor -%}
              </div>
            </details>
          {%- endfor -%}
          <details>
            <summary>{{ section.settings.label_heading }}<svg aria-hidden="true"><use href="#i-plus"/></svg></summary>
            <div class="tabs__body">
              <p>{% render 'voltiz-t', t: section.settings.ingredients %}</p>
              {%- assign rows = section.settings.nutrition | newline_to_br | split: '<br />' -%}
              <table class="nutri">
                <caption>{{ section.settings.nutrition_caption }}</caption>
                <tbody>
                  {%- for r in rows -%}
                    {%- assign r = r | strip -%}
                    {%- if r != blank -%}
                      {%- assign cells = r | split: '|' -%}
                      {%- assign label = cells[0] | strip -%}
                      {%- assign value = cells[1] | strip -%}
                      <tr{% if label contains 'dont ' %} class="sub"{% endif %}><th scope="row">{{ label }}</th><td>{% render 'voltiz-t', t: value %}</td></tr>
                    {%- endif -%}
                  {%- endfor -%}
                </tbody>
              </table>
              {%- if section.settings.label_note != blank -%}<p class="more__note">{% render 'voltiz-t', t: section.settings.label_note %}</p>{%- endif -%}
            </div>
          </details>
        </div>
      </div>
    </div>

    {%- if product != blank and product.available and section.settings.sticky -%}
      <div class="stick" data-vz-stick aria-hidden="true">
        <div class="wrap stick__in">
          <p class="stick__name"><svg aria-hidden="true"><use href="#i-bolt"/></svg><span>{{ product.title }}</span></p>
          <button class="btn" type="submit" form="vz-order" tabindex="-1"><span data-vz-cta-text>{{ section.settings.button_label | replace: '[n]', best_label }}</span><svg aria-hidden="true"><use href="#i-arrow"/></svg></button>
        </div>
      </div>
    {%- endif -%}
  </section>
</div>

{% schema %}
{
  "name": "Voltiz : produit",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Ancre", "default": "acheter" },
    { "type": "image_picker", "id": "image", "label": "Photo du sachet (facultatif)", "info": "Sans photo, la photo du produit s’affiche, sinon un visuel jaune à l’éclair." },
    { "type": "text", "id": "eyebrow", "label": "Petit texte au-dessus", "default": "Boutique" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Voltiz Energy Candy." },
    { "type": "textarea", "id": "sub", "label": "Sous-titre", "default": "Le bonbon énergisant au maté. 50 mg de caféine par bonbon, sans sucre." },
    { "type": "product", "id": "product", "label": "Produit" },
    { "type": "checkbox", "id": "show_price", "label": "Afficher le prix", "default": false },
    { "type": "text", "id": "packs_heading", "label": "Titre du choix de pack", "default": "Choisis ta réserve" },
    { "type": "range", "id": "max_qty", "label": "Quantité maximum", "min": 1, "max": 20, "step": 1, "default": 20 },
    { "type": "text", "id": "button_label", "label": "Texte du bouton", "info": "[n] est remplacé par le pack choisi, par exemple « 3 strips ».", "default": "Ajouter [n] au panier" },
    { "type": "text", "id": "checks", "label": "Rassurance", "info": "Séparés par le signe |.", "default": "Paiement sécurisé | Livraison en Suisse | Frais affichés avant le paiement" },
    { "type": "checkbox", "id": "sticky", "label": "Barre d’achat en bas de l’écran", "default": true },
    { "type": "text", "id": "closed_text", "label": "Message si le produit n’est pas en vente", "default": "Les commandes ouvrent bientôt." },
    { "type": "text", "id": "label_heading", "label": "Titre du volet étiquette", "default": "Ingrédients et valeurs nutritionnelles" },
    { "type": "textarea", "id": "ingredients", "label": "Ingrédients", "default": "Extrait de yerba maté, caféine, arôme, vitamine B12. [À COMPLÉTER : liste complète du fabricant]" },
    { "type": "text", "id": "nutrition_caption", "label": "Titre du tableau", "default": "Valeurs nutritionnelles" },
    { "type": "textarea", "id": "nutrition", "label": "Tableau", "info": "Une ligne par valeur, sous la forme « Nom | valeur ».", "default": "Caféine | 50 mg par bonbon\nSucres | 0 g\nÉnergie | [À COMPLÉTER]\nVitamine B12 | [À COMPLÉTER]" },
    { "type": "text", "id": "label_note", "label": "Note sous le tableau", "default": "Contient de la caféine. Déconseillé aux enfants et aux femmes enceintes ou allaitantes." }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Point clé",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "value", "label": "Chiffre ou mot", "default": "50 mg" },
        { "type": "text", "id": "text", "label": "Texte", "default": "de caféine par bonbon" }
      ]
    },
    {
      "type": "pack",
      "name": "Pack",
      "limit": 4,
      "settings": [
        { "type": "range", "id": "qty", "label": "Nombre de strips", "min": 1, "max": 20, "step": 1, "default": 1 },
        { "type": "text", "id": "unit", "label": "Unité", "default": "strip" },
        { "type": "text", "id": "text", "label": "Texte", "default": "Pour essayer." },
        { "type": "text", "id": "tag", "label": "Étiquette (facultatif)" },
        { "type": "checkbox", "id": "highlight", "label": "Mettre en avant et présélectionner", "default": false }
      ]
    },
    {
      "type": "tab",
      "name": "Volet d’infos",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "Titre", "default": "Comment l’utiliser" },
        { "type": "textarea", "id": "text", "label": "Texte", "info": "Un paragraphe par ligne.", "default": "Laisse fondre un bonbon en bouche." }
      ]
    }
  ],
  "presets": [{ "name": "Voltiz : produit" }]
}
{% endschema %}
