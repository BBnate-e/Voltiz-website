{%- comment -%} La formule : les ingrédients autour du bonbon, puis des pastilles et un bouton. {%- endcomment -%}
<div class="vz">
  <section class="sec sec--soft" id="{{ section.settings.anchor }}" aria-labelledby="formule-titre-{{ section.id }}">
    <div class="wrap">
      <div class="sec__head sec__head--center" data-reveal>
        {%- if section.settings.kicker != blank -%}<p class="kicker">{{ section.settings.kicker }}</p>{%- endif -%}
        <h2 id="formule-titre-{{ section.id }}" class="sec__title">{{ section.settings.heading }}</h2>
      </div>
      <div class="formula">
        <div class="formula__center" aria-hidden="true" data-reveal>
          <div class="mark"><span class="mark__ring"></span><span class="mark__hatch"></span><svg class="mark__bolt"><use href="#i-bolt"/></svg></div>
        </div>
        {%- for block in section.blocks -%}
          <div class="ing ing--{% cycle 'a', 'b', 'c', 'd' %}" data-reveal {{ block.shopify_attributes }}>
            <span class="ing__icon" aria-hidden="true"><svg><use href="#i-{{ block.settings.icon }}"/></svg></span>
            <p class="ing__big">{{ block.settings.big }}</p>
            <p class="ing__role">{{ block.settings.role }}</p>
            <h3 class="ing__name">{{ block.settings.name }}</h3>
            <p class="ing__text">{% render 'voltiz-t', t: block.settings.text %}</p>
          </div>
        {%- endfor -%}
      </div>
      {%- assign pills = section.settings.pills | split: '|' -%}
      {%- if section.settings.pills != blank -%}
        <ul class="pills" role="list" data-reveal>
          {%- for p in pills -%}<li><svg aria-hidden="true"><use href="#i-check"/></svg>{{ p | strip }}</li>{%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <p class="center" data-reveal><a class="btn" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}<svg aria-hidden="true"><use href="#i-arrow"/></svg></a></p>
      {%- endif -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Voltiz : formule",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Ancre", "default": "formule" },
    { "type": "text", "id": "kicker", "label": "Petit texte au-dessus", "default": "La formule" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Chaque bonbon est dosé exprès." },
    { "type": "text", "id": "pills", "label": "Pastilles", "info": "Séparées par le signe |.", "default": "0 g de sucre | 50 mg de caféine | Au maté | Fabriqué en Suisse" },
    { "type": "text", "id": "button_label", "label": "Texte du bouton", "default": "Commander" },
    { "type": "text", "id": "button_link", "label": "Lien du bouton", "default": "/pages/boutique" }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingrédient",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icône", "default": "leaf", "options": [
          { "value": "leaf", "label": "Feuille" }, { "value": "bolt", "label": "Éclair" }, { "value": "flask", "label": "Flacon" }, { "value": "sparkle", "label": "Étincelle" } ] },
        { "type": "text", "id": "big", "label": "Grand texte", "default": "50 mg" },
        { "type": "text", "id": "role", "label": "Rôle", "default": "Le boost" },
        { "type": "text", "id": "name", "label": "Nom", "default": "Caféine" },
        { "type": "text", "id": "text", "label": "Texte", "default": "La base du boost." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Voltiz : formule" }]
}
{% endschema %}
