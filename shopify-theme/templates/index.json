    "faq": {
      "type": "voltiz-faq",
      "settings": {},
      "blocks": {
        "b_1": {
          "type": "question",
          "settings": {
            "question": "C’est un chewing-gum ?",
            "answer": "Non. Voltiz est un bonbon mou en forme d’éclair, qu’on mâche et qu’on avale."
          }
        },
        "b_2": {
          "type": "question",
          "settings": {
            "question": "Combien de caféine dans un gum ?",
            "answer": "50 mg : 20 mg viennent de l’extrait de maté et 30 mg du guarana."
          }
        },
        "b_3": {
          "type": "question",
          "settings": {
            "question": "Combien j’en prends ?",
            "answer": "Un gum pour un boost, deux pour un gros boost. Ne dépasse pas la dose recommandée : [À COMPLÉTER : nombre de gums par jour]."
          }
        },
        "b_4": {
          "type": "question",
          "settings": {
            "question": "Il y a du sucre ?",
            "answer": "Non, Voltiz est sans sucre. Il est sucré avec des édulcorants."
          }
        },
        "b_5": {
          "type": "question",
          "settings": {
            "question": "Comment je commande et je paie ?",
            "answer": "Choisis ta saveur et ta quantité en bas de la page, puis ajoute au panier. Tu paies en ligne à la caisse et tu reçois une confirmation par e-mail."
          }
        },
        "b_6": {
          "type": "question",
          "settings": {
            "question": "Vous livrez où ?",
            "answer": "Partout en Suisse. Les frais de livraison s’affichent à la caisse, avant le paiement. Délai : [À COMPLÉTER]."
          }
        },
        "b_7": {
          "type": "question",
          "settings": {
            "question": "C’est pour qui ?",
            "answer": "Pour les adultes qui veulent un coup de boost. Pas pour les enfants, les femmes enceintes ou allaitantes, ni les personnes sensibles à la caféine."
          }
        }
      },
