          "settings": {
            "question": "C’est quoi, Voltiz ?",
            "answer": "Un bonbon énergisant au maté, sans sucre, avec 50 mg de caféine par bonbon. Fabriqué en Suisse."
          }
        },
        "b_2": {
          "type": "question",
          "settings": {
            "question": "En combien de temps je sens l’effet ?",
            "answer": "La caféine est absorbée directement dans la bouche : compte 5 à 10 minutes."
          }
        },
        "b_3": {
          "type": "question",
          "settings": {
            "question": "Combien de bonbons par jour ?",
            "answer": "Un bonbon contient 50 mg de caféine, à peu près un expresso. Ne dépasse pas [À COMPLÉTER : nombre de bonbons] par jour et pense au café, au thé et aux boissons que tu bois aussi."
          }
        },
        "b_4": {
          "type": "question",
          "settings": {
            "question": "Ça a quel goût ?",
            "answer": "Saveur citron. L’arôme masque l’amertume de la caféine."
          }
        },
        "b_5": {
          "type": "question",
          "settings": {
            "question": "Qui ne devrait pas en prendre ?",
            "answer": "Les enfants, les femmes enceintes ou allaitantes et les personnes sensibles à la caféine."
          }
        },
        "b_6": {
          "type": "question",
          "settings": {
            "question": "Vous livrez où ?",
            "answer": "Partout en Suisse. Les frais de port s’affichent avant le paiement."
          }
        },
