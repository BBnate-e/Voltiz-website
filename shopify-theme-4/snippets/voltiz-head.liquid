{%- comment -%}
  Brouillon 4 : mêmes polices et styles que le brouillon 3 (voltiz3.css, voltiz3.js), plus l'animation d'ouverture (voltiz4.css, voltiz4.js).
  Sora et Manrope : licence SIL Open Font License 1.1, fichiers hébergés dans le thème.
{%- endcomment -%}
<link rel="preload" href="{{ 'voltiz-sora.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="{{ 'voltiz-manrope.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
<style>
  @font-face {
    font-family: "Sora";
    font-style: normal;
    font-weight: 100 800;
    font-display: swap;
    src: url("{{ 'voltiz-sora.woff2' | asset_url }}") format("woff2");
  }
  @font-face {
    font-family: "Manrope";
    font-style: normal;
    font-weight: 200 800;
    font-display: swap;
    src: url("{{ 'voltiz-manrope.woff2' | asset_url }}") format("woff2");
  }
  :root {
    --font-body--family: "Manrope", system-ui, -apple-system, "Segoe UI", sans-serif;
    --font-subheading--family: "Manrope", system-ui, -apple-system, "Segoe UI", sans-serif;
    --font-heading--family: "Sora", system-ui, -apple-system, "Segoe UI", sans-serif;
    --font-heading--style: normal;
    --font-heading--weight: 600;
    --font-accent--family: "Sora", system-ui, -apple-system, "Segoe UI", sans-serif;
    --font-accent--style: normal;
    --font-accent--weight: 600;
  }
</style>
{{ 'voltiz3.css' | asset_url | stylesheet_tag }}
{{ 'voltiz4.css' | asset_url | stylesheet_tag }}
<script>document.documentElement.classList.add('js')</script>
<script src="{{ 'voltiz3.js' | asset_url }}" defer></script>
<script src="{{ 'voltiz4.js' | asset_url }}" defer></script>
