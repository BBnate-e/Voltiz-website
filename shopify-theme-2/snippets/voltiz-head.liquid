{%- comment -%}
  Brouillon 2 : styles, police Montserrat et script Voltiz (voltiz2.css, voltiz2.js). Rendu dans layout/theme.liquid, après les variables d'Horizon,
  pour que les pages d'Horizon (produit, panier) prennent aussi Montserrat.
{%- endcomment -%}
<link rel="preload" href="{{ 'voltiz-montserrat.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
<style>
  @font-face {
    font-family: "Montserrat";
    font-style: normal;
    font-weight: 400 800;
    font-display: swap;
    src: url("{{ 'voltiz-montserrat.woff2' | asset_url }}") format("woff2");
  }
  :root {
    --font-body--family: "Montserrat", system-ui, -apple-system, "Segoe UI", sans-serif;
    --font-subheading--family: "Montserrat", system-ui, -apple-system, "Segoe UI", sans-serif;
    --font-heading--family: "Montserrat", system-ui, -apple-system, "Segoe UI", sans-serif;
    --font-heading--style: normal;
    --font-heading--weight: 700;
    --font-accent--family: "Montserrat", system-ui, -apple-system, "Segoe UI", sans-serif;
    --font-accent--style: normal;
    --font-accent--weight: 700;
  }
</style>
{{ 'voltiz2.css' | asset_url | stylesheet_tag }}
<script>document.documentElement.classList.add('js')</script>
<script src="{{ 'voltiz2.js' | asset_url }}" defer></script>
