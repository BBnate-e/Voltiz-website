{%- comment -%}
  Brouillon 5 : rappel des conditions de précommande, affiché sur la page panier avant le passage à la caisse.
{%- endcomment -%}
{%- if cart.item_count > 0 or request.design_mode -%}
<div class="v3 v5">
  <div class="wrap">
    <div class="pre5 pre5--cart" role="note">
      <p class="pre5__title"><svg aria-hidden="true" viewBox="0 0 256 256"><path fill="currentColor" d="M128,40a96,96,0,1,0,96,96A96.11,96.11,0,0,0,128,40Zm0,176a80,80,0,1,1,80-80A80.09,80.09,0,0,1,128,216ZM173.66,90.34a8,8,0,0,1,0,11.32l-40,40a8,8,0,0,1-11.32-11.32l40-40A8,8,0,0,1,173.66,90.34ZM96,16a8,8,0,0,1,8-8h48a8,8,0,0,1,0,16H104A8,8,0,0,1,96,16Z"/></svg>{{ section.settings.title }}</p>
      <p>{% render 'voltiz-t', t: section.settings.text %}</p>
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Voltiz 5 : avis panier",
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "Ta commande est une précommande" },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Le paiement se fait maintenant, à la caisse sécurisée Shopify. Expédition prévue : [À COMPLÉTER : date ou période d’expédition]. Tu reçois une confirmation par e-mail." }
  ],
  "presets": [{ "name": "Voltiz 5 : avis panier" }]
}
{% endschema %}
