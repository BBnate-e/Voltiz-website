{%- comment -%}
  Boutique (drop Mûre, 26.11) : les deux goûts côte à côte. Chaque carte mène à sa fiche produit,
  où l'on choisit le nombre de paquets. Un produit vide ou non publié n'affiche pas sa carte.
{%- endcomment -%}
<div class="v3 v5">
  <section class="shop12" aria-labelledby="shop12-t-{{ section.id }}">
    <div class="wrap">
      <header class="head">
        {%- if section.settings.kicker != blank -%}<p class="label">{{ section.settings.kicker }}</p>{%- endif -%}
        <h1 id="shop12-t-{{ section.id }}" class="title">{{ section.settings.heading }}</h1>
        {%- if section.settings.text != blank -%}<p class="shop12__text">{{ section.settings.text }}</p>{%- endif -%}
      </header>
      <ul class="shop12__list" role="list">
        {%- for block in section.blocks -%}
          {%- assign p = block.settings.product -%}
          {%- if p == blank -%}{%- continue -%}{%- endif -%}
          {%- assign mure = false -%}
          {%- if block.settings.tone == 'mure' -%}{%- assign mure = true -%}{%- endif -%}
          <li class="shop12__item{% if mure %} is-mure{% endif %}" {{ block.shopify_attributes }}>
            <a class="shop12__card" href="{{ p.url }}">
              <span class="shop12__media">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 900 | image_tag: widths: '360, 540, 720, 900', sizes: '(min-width: 990px) 26vw, 60vw', alt: p.title, loading: 'eager', class: 'shop12__img' }}
                {%- elsif p.featured_image -%}
                  {{ p.featured_image | image_url: width: 900 | image_tag: sizes: '(min-width: 990px) 26vw, 60vw', alt: p.title, class: 'shop12__img' }}
                {%- endif -%}
              </span>
              <span class="shop12__body">
                {%- if block.settings.tag != blank -%}<span class="shop12__tag">{{ block.settings.tag }}</span>{%- endif -%}
                <span class="shop12__name">{{ block.settings.name | default: p.title }}</span>
                {%- if block.settings.line != blank -%}<span class="shop12__line">{{ block.settings.line }}</span>{%- endif -%}
                <span class="shop12__price">{{ section.settings.from_label }} {{ p.price_min | money }}</span>
                <span class="btn shop12__btn{% if mure %} btn--mure{% endif %}">{{ section.settings.button_label }}<svg aria-hidden="true"><use href="#i-arrow"/></svg></span>
              </span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
      {%- if section.settings.note != blank -%}<p class="shop12__note">{{ section.settings.note }}</p>{%- endif -%}
    </div>
  </section>
</div>
<style>
  .v3 .shop12 { padding: clamp(48px, 7vw, 96px) 0 clamp(56px, 8vw, 110px); background: var(--white, #fff); }
  .v3 .shop12 .head { display: grid; justify-items: center; text-align: center; max-width: 640px; margin: 0 auto clamp(28px, 4vw, 48px); }
  .v3 .shop12__text { max-width: 560px; margin: 14px auto 0; color: #5A6B80; font-size: 1rem; line-height: 1.55; }
  .v3 .shop12__list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(16px, 2.4vw, 32px); max-width: 980px; margin: 0 auto; padding: 0; list-style: none; }
  .v3 .shop12__card { display: grid; height: 100%; border: 1px solid var(--g2, #E3E6EA); border-radius: var(--r, 14px); overflow: hidden; background: var(--white, #fff); color: var(--navy, #0F2643); text-decoration: none;
    transition: border-color .25s, box-shadow .25s, transform .25s; }
  .v3 .shop12__card:hover { border-color: var(--navy, #0F2643); box-shadow: 0 24px 50px -30px rgba(15,38,67,.45); transform: translateY(-2px); }
  .v3 .shop12__card:focus-visible { outline: 2px solid var(--navy, #0F2643); outline-offset: 3px; }
  .v3 .shop12__media { display: grid; place-items: center; padding: clamp(24px, 3.4vw, 44px) 16px clamp(14px, 2vw, 24px);
    background: radial-gradient(70% 60% at 50% 45%, rgba(254,205,6,.22), rgba(254,205,6,0) 70%), #F4F6F8; }
  .v3 .is-mure .shop12__media { background: radial-gradient(70% 60% at 50% 45%, rgba(143,35,99,.18), rgba(143,35,99,0) 70%), #F7F2F5; }
  .v3 .shop12__img { width: min(62%, 250px); height: auto; filter: drop-shadow(0 26px 24px rgba(15,38,67,.28)); transition: transform .35s var(--ease, ease); }
  .v3 .shop12__card:hover .shop12__img { transform: translateY(-4px) rotate(-1.5deg); }
  .v3 .shop12__body { display: grid; justify-items: start; gap: 8px; padding: 20px 22px 24px; }
  .v3 .shop12__tag { padding: 5px 10px; border-radius: 999px; background: var(--mure, #8F2363); color: #fff; font: 700 .625rem/1 var(--f, inherit); letter-spacing: .14em; text-transform: uppercase; }
  .v3 .shop12__name { font: 400 clamp(1.25rem, 1.8vw, 1.6rem)/1.1 var(--h, inherit); text-transform: uppercase; }
  .v3 .shop12__line { color: #5A6B80; font-size: .9375rem; line-height: 1.45; }
  .v3 .shop12__price { font: 400 1.125rem/1 var(--h, inherit); font-variant-numeric: tabular-nums; margin-top: 2px; }
  .v3 .shop12__btn { margin-top: 8px; pointer-events: none; }
  .v3 .shop12__btn svg { width: 16px; height: 16px; }
  .v3 .is-mure .shop12__card { border-color: rgba(143,35,99,.28); }
  .v3 .is-mure .shop12__card:hover { border-color: var(--mure, #8F2363); box-shadow: 0 24px 50px -30px rgba(143,35,99,.55); }
  .v3 .shop12__note { margin: clamp(22px, 3vw, 34px) auto 0; max-width: 620px; text-align: center; color: #5A6B80; font-size: .875rem; line-height: 1.5; }
  @media (max-width: 749px) {
    .v3 .shop12__list { grid-template-columns: 1fr; max-width: 420px; }
    .v3 .shop12__img { width: min(50%, 200px); }
  }
  @media (prefers-reduced-motion: reduce) { .v3 .shop12__card, .v3 .shop12__img { transition: none; } .v3 .shop12__card:hover, .v3 .shop12__card:hover .shop12__img { transform: none; } }
</style>

{% schema %}
{
  "name": "Voltiz 12 : boutique",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Surtitre", "default": "Précommande" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Boutique" },
    { "type": "textarea", "id": "text", "label": "Texte" },
    { "type": "text", "id": "from_label", "label": "Avant le prix", "default": "Dès" },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "Choisir" },
    { "type": "textarea", "id": "note", "label": "Note sous les produits" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Produit",
      "settings": [
        { "type": "product", "id": "product", "label": "Produit" },
        { "type": "image_picker", "id": "image", "label": "Image du sachet" },
        { "type": "text", "id": "name", "label": "Nom affiché" },
        { "type": "text", "id": "line", "label": "Petite phrase" },
        { "type": "text", "id": "tag", "label": "Mention" },
        { "type": "select", "id": "tone", "label": "Couleur", "default": "citron", "options": [
          { "value": "citron", "label": "Citron" }, { "value": "mure", "label": "Mûre" }
        ] }
      ]
    }
  ],
  "presets": [{ "name": "Voltiz 12 : boutique" }]
}
{% endschema %}
